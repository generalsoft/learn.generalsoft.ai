rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /messages/{messageId} {
      allow read: if false;

      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
        request.resource.data.size() <= 6 &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.message is string &&
        request.resource.data.email.matches('.+@.+[.].+');

      allow update, delete: if false;
    }

    match /registrations/{regId} {
      // Read access is required for:
      //  - duplicate detection (single-doc get)
      //  - resend verification (single-doc get)
      //  - token verification (list query by token)
      allow read: if true;

      // Allow creating a new registration document, as long as the
      // required fields are present and it starts in "pending" status.
      allow create: if
        request.resource.data.keys().hasAll([
          'courseId',
          'firstName',
          'lastName',
          'email',
          'emailNormalized',
          'registrationType',
          'status',
          'token',
          'createdAt'
        ]) &&
        request.resource.data.status == 'pending';

      // Allow updating verification-related fields only, while keeping the
      // identity fields (email/courseId) unchanged.
      allow update: if
        request.resource.data.email == resource.data.email &&
        request.resource.data.courseId == resource.data.courseId;
    }

  }
}